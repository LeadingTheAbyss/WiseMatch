# Neon Postgres connection string (leave empty to use a local SQLite file for dev)
DATABASE_URL=

# Qloo hackathon API (leave empty to run on the built-in mock taste graph)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Groq (OpenAI-compatible) for the matching agent and chat personas
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Auth + CORS
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000

# Number of Bangalore profiles to seed on first start
SEED_USERS=650
